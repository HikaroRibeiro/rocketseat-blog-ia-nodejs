{
  "name": "rocketseat-blog-ia-nodejs",
  "version": "1.0.0",
  "description": "API REST para cadastro de postagens e comentários",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env.local index.js",
    "dev": "node --watch --env-file=.env.local index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install || true",
    "install-hooks": "lefthook install"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.14",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
